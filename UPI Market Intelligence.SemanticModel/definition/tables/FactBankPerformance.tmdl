/// Monthly performance of the 20 largest sending (remitter) banks: approvals and declines.
table FactBankPerformance
	lineageTag: f1086df8-ee71-5edc-a782-afda5420c2af

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: ecf5ffee-22ae-55bb-b50a-704449b549e6
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Bank Key'
		dataType: string
		isHidden
		lineageTag: 0c4a9210-4035-558f-8bf1-27b94dfc469f
		summarizeBy: none
		sourceColumn: Bank Key

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: db03f498-0e3b-5856-96d9-e86bc24bb8a2
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Approved %'
		dataType: double
		formatString: 0.00%
		lineageTag: 4f9c749c-6fc3-5edc-b80d-7b156783c520
		summarizeBy: none
		sourceColumn: Approved %

		annotation SummarizationSetBy = Automatic

	column 'Business Decline %'
		dataType: double
		formatString: 0.00%
		lineageTag: e7742ff2-2fe4-5a7d-9e40-ec1e0a5ce150
		summarizeBy: none
		sourceColumn: Business Decline %

		annotation SummarizationSetBy = Automatic

	column 'Technical Decline %'
		dataType: double
		formatString: 0.00%
		lineageTag: 3c8ae323-497e-5ce3-ac29-dc718759b6be
		summarizeBy: none
		sourceColumn: Technical Decline %

		annotation SummarizationSetBy = Automatic

	partition FactBankPerformance = m
		mode: import
		source =
				// Source: data/upi_bank_performance.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", type text}, {"bank", type text}, {"volume_mn", type number}, {"approved_pct", type number}, {"business_decline_pct", type number}, {"technical_decline_pct", type number}}, "en-US"),
				    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date([year], List.PositionOf(MonthNames, [month]) + 1, 1), type date),
				    BankKey = Table.AddColumn(AddDate, "Bank Key", each Text.Upper(Text.Trim([bank])), type text),
				    AsFractions = Table.TransformColumns(BankKey, {{"approved_pct", each _ / 100, type number}, {"business_decline_pct", each _ / 100, type number}, {"technical_decline_pct", each _ / 100, type number}}),
				    Renamed = Table.RenameColumns(AsFractions, {{"volume_mn", "Volume Mn"}, {"approved_pct", "Approved %"}, {"business_decline_pct", "Business Decline %"}, {"technical_decline_pct", "Technical Decline %"}}),
				    Result = Table.SelectColumns(Renamed, {"Date", "Bank Key", "Volume Mn", "Approved %", "Business Decline %", "Technical Decline %"})
				in
				    Result

	annotation PBI_ResultType = Table

