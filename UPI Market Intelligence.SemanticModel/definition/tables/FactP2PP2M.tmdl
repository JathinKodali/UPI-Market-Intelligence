/// Person-to-person (P2P) vs person-to-merchant (P2M) UPI payments, unpivoted to one row per type.
table FactP2PP2M
	lineageTag: 96e6862c-2eda-5eec-b6d0-5f329d8c0f23

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: a39c0d05-96aa-573c-bda8-35f38df4996a
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: 47e3371d-d19b-5b3d-89bc-c012474789ac
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Value Cr'
		dataType: double
		formatString: #,0.00
		lineageTag: d9aeb7f2-e120-5245-9530-21e0f1bc42fb
		summarizeBy: sum
		sourceColumn: Value Cr

		annotation SummarizationSetBy = Automatic

	column 'Payment Type'
		dataType: string
		lineageTag: b0fe0a2f-b11e-5362-88e2-3d0fc6ba99e1
		summarizeBy: none
		sourceColumn: Payment Type

		annotation SummarizationSetBy = Automatic

	partition FactP2PP2M = m
		mode: import
		source =
				// Source: data/upi_p2p_p2m.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", type text}, {"p2p_volume_mn", type number}, {"p2p_value_cr", type number}, {"p2m_volume_mn", type number}, {"p2m_value_cr", type number}}, "en-US"),
				    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date([year], List.PositionOf(MonthNames, [month]) + 1, 1), type date),
				    P2P = Table.AddColumn(Table.RenameColumns(Table.SelectColumns(AddDate, {"Date", "p2p_volume_mn", "p2p_value_cr"}), {{"p2p_volume_mn", "Volume Mn"}, {"p2p_value_cr", "Value Cr"}}), "Payment Type", each "P2P", type text),
				    P2M = Table.AddColumn(Table.RenameColumns(Table.SelectColumns(AddDate, {"Date", "p2m_volume_mn", "p2m_value_cr"}), {{"p2m_volume_mn", "Volume Mn"}, {"p2m_value_cr", "Value Cr"}}), "Payment Type", each "P2M", type text),
				    Combined = Table.Combine({P2P, P2M}),
				    Result = Table.TransformColumnTypes(Combined, {{"Volume Mn", type number}, {"Value Cr", type number}, {"Payment Type", type text}})
				in
				    Result

	annotation PBI_ResultType = Table

