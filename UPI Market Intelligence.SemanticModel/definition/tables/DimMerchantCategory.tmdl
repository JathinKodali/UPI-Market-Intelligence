/// Merchant category codes (MCC) with short names and a sector grouping.
table DimMerchantCategory
	lineageTag: a354c01c-c119-5bfb-b970-26913390492f

	column MCC
		dataType: string
		lineageTag: 2d8db465-1d19-55dd-b5ad-1d0e0ad96d93
		summarizeBy: none
		sourceColumn: MCC

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: d1ef0e54-b405-5868-b7b1-457345f735ac
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Sector
		dataType: string
		lineageTag: 485ec8ab-af8c-5a1b-ad0f-66b3ce8bd0b1
		summarizeBy: none
		sourceColumn: Sector

		annotation SummarizationSetBy = Automatic

	partition DimMerchantCategory = m
		mode: import
		source =
				// Source: data/dim_merchant_category.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"mcc", type text}, {"category", type text}, {"sector", type text}}, "en-US"),
				    Result = Table.RenameColumns(Typed, {{"mcc", "MCC"}, {"category", "Category"}, {"sector", "Sector"}})
				in
				    Result

	annotation PBI_ResultType = Table

