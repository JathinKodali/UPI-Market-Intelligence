/// Monthly merchant payments by merchant category code (top ~30 categories + all others).
table FactMerchantCategory
	lineageTag: 081b6873-f85b-5a43-9e54-c9de57489491

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 2d68b313-670f-5e63-8a19-486eba45131f
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column MCC
		dataType: string
		lineageTag: 77437d2b-4dc5-517b-9525-c1bcca2c321c
		summarizeBy: none
		sourceColumn: MCC

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: 14bf6730-8474-5deb-b949-c15b59c2e01a
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Value Cr'
		dataType: double
		formatString: #,0
		lineageTag: 17aeebcc-ed24-51e2-836d-baadcbd86c4b
		summarizeBy: sum
		sourceColumn: Value Cr

		annotation SummarizationSetBy = Automatic

	partition FactMerchantCategory = m
		mode: import
		source =
				// Source: data/upi_merchant_category.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", type text}, {"mcc", type text}, {"volume_mn", type number}, {"value_cr", type number}}, "en-US"),
				    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date([year], List.PositionOf(MonthNames, [month]) + 1, 1), type date),
				    Renamed = Table.RenameColumns(AddDate, {{"mcc", "MCC"}, {"volume_mn", "Volume Mn"}, {"value_cr", "Value Cr"}}),
				    Result = Table.SelectColumns(Renamed, {"Date", "MCC", "Volume Mn", "Value Cr"})
				in
				    Result

	annotation PBI_ResultType = Table

