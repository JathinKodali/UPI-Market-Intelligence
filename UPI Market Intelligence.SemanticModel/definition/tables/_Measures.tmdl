		displayFolder: 3 Merchant payments
		lineageTag: d0be391a-e079-53cc-99f3-ff393d8c5741

	measure 'Merchant Value (Cr)' = SUM ( FactMerchantCategory[Value Cr] )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: 902c9c69-3ab7-5ea1-a983-390157b7895e

	measure 'Merchant Volume Mn (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [Merchant Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: 8d364514-8ffd-5a40-9990-5ca25bc38be3

	measure 'Merchant Value Cr (Month)' =
