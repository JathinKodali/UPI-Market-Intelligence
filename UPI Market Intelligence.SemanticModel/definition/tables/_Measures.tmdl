	/// Transactions for the 15 largest named merchant categories in the selected month.
	measure 'Top 15 Category Volume Mn (Month)' =
			VAR _v = [Named Category Volume Mn (Month)]
			VAR _r =
			    RANKX (
			        FILTER ( ALL ( DimMerchantCategory[Category] ), NOT ISBLANK ( [Named Category Volume Mn (Month)] ) ),
			        [Named Category Volume Mn (Month)], , DESC
			    )
			RETURN
			    IF ( NOT ISBLANK ( _v ) && _r <= 15, _v )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: cfaeace7-5836-540e-9393-2e2628ccf099

	measure 'Top Category (Month)' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( ALL ( DimMerchantCategory[Category] ), NOT ISBLANK ( [Named Category Volume Mn (Month)] ) ),
			        [Named Category Volume Mn (Month)], DESC
			    )
			RETURN
			    MAXX ( _t, DimMerchantCategory[Category] )
		displayFolder: 3 Merchant payments
		lineageTag: 39a7c6b8-812b-5cb0-8503-41629921d318

	measure 'Top Category Volume Bn (Month)' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( ALL ( DimMerchantCategory[Category] ), NOT ISBLANK ( [Named Category Volume Mn (Month)] ) ),
			        [Named Category Volume Mn (Month)], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( _t, [Named Category Volume Mn (Month)] ), 1000 )
		formatString: #,0.00
		displayFolder: 3 Merchant payments
		lineageTag: 157cd2fd-e356-52e5-8038-eacf439102c4

	/// Fee rate chosen in the slicer. Defaults to NPCI's 0.40%.
	measure 'MDR Rate (Selected)' = SELECTEDVALUE ( 'MDR Rate Options'[MDR Rate], 0.004 )
		formatString: 0.00%
		displayFolder: 4 MDR simulator
		lineageTag: 4adbfd1b-952b-5a6f-a7a4-b133af68e4db

	/// Share of merchant payment value in transactions above Rs 2,000. Defaults to the 67% reported for Aug 2026.
	measure 'High-Value Share (Selected)' = SELECTEDVALUE ( 'High Value Share Options'[Share], 0.67 )
		formatString: 0%
		displayFolder: 4 MDR simulator
		lineageTag: 9688b400-d3e9-52a7-8b86-93181e215f39

	/// Reduction for the Rs 300 cap, the Rs 5 flat fee in notified sectors and the small-merchant exemption.
	measure 'Cap Adjustment (Selected)' = SELECTEDVALUE ( 'Cap Adjustment Options'[Adjustment], 0 )
		formatString: 0%
		displayFolder: 4 MDR simulator
		lineageTag: 3bfff453-1aa5-5a59-aecf-ec8b1068a77b

	measure 'P2M Value Cr (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [P2M Value (Cr)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0
		displayFolder: 4 MDR simulator
		lineageTag: 542aea23-d0eb-5d24-9cea-47b09fda4e51

	measure 'P2M Value Lakh Cr (Month)' = DIVIDE ( [P2M Value Cr (Month)], 100000 )
		formatString: #,0.00
		displayFolder: 4 MDR simulator
		lineageTag: e51cf2d0-9cb3-50d0-b375-c4c34c6fba2d

	measure 'MDR-Eligible Value Lakh Cr (Month)' = [P2M Value Lakh Cr (Month)] * [High-Value Share (Selected)]
		formatString: #,0.00
		displayFolder: 4 MDR simulator
		lineageTag: 414ce7d1-6750-594a-9556-8f2b4ecbef6a

	/// Estimated merchant fee revenue for one month, in rupees crore.
	measure 'Est. MDR Revenue Cr (Month)' = [P2M Value Cr (Month)] * [High-Value Share (Selected)] * [MDR Rate (Selected)] * ( 1 - [Cap Adjustment (Selected)] )
		formatString: #,0
		displayFolder: 4 MDR simulator
		lineageTag: 094adf4c-2c4c-5d14-9548-e96f289879e7

	measure 'Est. MDR Revenue Cr (Annualised)' = [Est. MDR Revenue Cr (Month)] * 12
		formatString: #,0
		displayFolder: 4 MDR simulator
		lineageTag: aebdcbe9-a061-5fe3-80be-a64607d5f788

	/// Revenue split using the sharing formula reported in the press (issuer 40%, acquirer 30%, app 20%, app's bank 10%).
	measure 'MDR Revenue by Party Cr' = [Est. MDR Revenue Cr (Month)] * SUM ( 'MDR Split'[Share] )
		formatString: #,0
		displayFolder: 4 MDR simulator
		lineageTag: 15d5e61c-583f-54f8-a794-35b983ddaeca

	measure 'App Value Share % (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    DIVIDE (
			        CALCULATE ( [App Value (Cr)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m ),
			        CALCULATE ( [App Value (Cr)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m, REMOVEFILTERS ( DimApp ) )
			    )
		formatString: 0.0%
		displayFolder: 4 MDR simulator
		lineageTag: ac099baa-3885-56d3-a52a-fb61b3de674c

	/// Approximation: the apps' 20% pool split by each app's share of total UPI value.
	measure 'Est. App MDR Income Cr (Month)' = [Est. MDR Revenue Cr (Month)] * 0.2 * [App Value Share % (Month)]
		formatString: #,0.00
		displayFolder: 4 MDR simulator
		lineageTag: 94b33d92-6956-5377-b3ab-f34078c84a72

	measure 'Bank Volume (Mn)' = SUM ( FactBankPerformance[Volume Mn] )
		formatString: #,0
		displayFolder: 5 Banks
		lineageTag: b8641710-7e10-5be9-b80e-b6b1ae47aa5e

	/// Volume-weighted share of payment attempts that succeeded.
	measure 'Approval Rate %' = DIVIDE ( SUMX ( FactBankPerformance, FactBankPerformance[Volume Mn] * FactBankPerformance[Approved %] ), [Bank Volume (Mn)] )
		formatString: 0.00%
		displayFolder: 5 Banks
		lineageTag: ccefe2bb-5e4d-53d6-afec-36efaf183305

	/// Declines caused by the customer or rules: wrong PIN, insufficient balance, limits.
	measure 'Business Decline %' = DIVIDE ( SUMX ( FactBankPerformance, FactBankPerformance[Volume Mn] * FactBankPerformance[Business Decline %] ), [Bank Volume (Mn)] )
		formatString: 0.00%
		displayFolder: 5 Banks
		lineageTag: 6c4d9ea1-578f-5e5c-9675-59c289fcf533

	/// Declines caused by bank or NPCI system problems.
	measure 'Technical Decline %' = DIVIDE ( SUMX ( FactBankPerformance, FactBankPerformance[Volume Mn] * FactBankPerformance[Technical Decline %] ), [Bank Volume (Mn)] )
		formatString: 0.00%
		displayFolder: 5 Banks
		lineageTag: 87b01b5a-dea1-53e2-80e7-735629a702f8

