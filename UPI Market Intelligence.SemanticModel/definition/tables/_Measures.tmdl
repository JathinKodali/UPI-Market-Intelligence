	measure 'P2M Share of Value % (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [P2M Share of Value %], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: 0.0%
		displayFolder: 3 Merchant payments
		lineageTag: 1778ba7b-343f-589e-b134-2279e3564197

	measure 'P2M Share of Value % (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [P2M Share of Value %], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: 0.0%
		displayFolder: 3 Merchant payments
		lineageTag: 36775c89-65fc-5925-b2f6-a212174d244f

	measure 'P2M Volume Bn (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [P2M Volume (Mn)] / 1000, REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 3 Merchant payments
		lineageTag: d40c03b6-a6a5-59bc-9e77-6183cff13e59

	measure 'P2M Volume Bn (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [P2M Volume (Mn)] / 1000, REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 3 Merchant payments
		lineageTag: 730e87cd-6b4c-5f05-b68e-351d93a9dd7f

	measure 'Avg P2M Ticket ₹ (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( DIVIDE ( [P2M Value (Cr)], [P2M Volume (Mn)] ) * 10, REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: ₹#,0
		displayFolder: 3 Merchant payments
		lineageTag: 41867ec6-ec44-53ec-928e-f50c3644fcec

	measure 'Avg P2M Ticket ₹ (Same Month LY)' =
