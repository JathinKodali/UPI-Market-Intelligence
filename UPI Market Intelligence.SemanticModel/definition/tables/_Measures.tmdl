	measure 'Merchant Volume YoY % (Month)' =
			VAR _cur = [Merchant Volume Mn (Month)]
			VAR _ly = [Merchant Volume Mn (Same Month LY)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ) && _ly > 0, DIVIDE ( _cur - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Merchant payments
		lineageTag: 72956ff5-a74f-5e1e-986c-8c40d8448243

	measure 'Category Avg Ticket ₹ (Month)' = DIVIDE ( [Merchant Value Cr (Month)], [Merchant Volume Mn (Month)] ) * 10
		formatString: ₹#,0
		displayFolder: 3 Merchant payments
		lineageTag: 4cfcb6af-4798-52d0-91cf-26eb4caa0d10

	measure 'Named Category Volume Mn (Month)' = CALCULATE ( [Merchant Volume Mn (Month)], KEEPFILTERS ( DimMerchantCategory[MCC] <> "OTH" ) )
		formatString: #,0
