	measure 'Avg P2P Ticket ₹ (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( DIVIDE ( [P2P Value (Cr)], [P2P Volume (Mn)] ) * 10, REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: ₹#,0
