		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: 0fa980c5-0ac9-5df4-a52a-e1ef6edb729c

	measure 'Named Category Avg Ticket ₹ (Month)' = CALCULATE ( [Category Avg Ticket ₹ (Month)], KEEPFILTERS ( DimMerchantCategory[MCC] <> "OTH" ) )
		formatString: ₹#,0
		displayFolder: 3 Merchant payments
		lineageTag: 12c53386-e1ec-555b-a7d0-ab7d904ee407

	measure 'Named Category YoY % (Month)' = CALCULATE ( [Merchant Volume YoY % (Month)], KEEPFILTERS ( DimMerchantCategory[MCC] <> "OTH" ) )
