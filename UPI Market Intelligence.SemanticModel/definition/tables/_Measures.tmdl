	measure 'P2M Volume (Mn)' = CALCULATE ( [P2x Volume (Mn)], FactP2PP2M[Payment Type] = "P2M" )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: e690a70e-f919-5037-a1c7-31e2099cb168

	measure 'P2M Value (Cr)' = CALCULATE ( [P2x Value (Cr)], FactP2PP2M[Payment Type] = "P2M" )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: d00e6a30-dc16-5aa1-9a19-148f2f1c4829

	measure 'P2P Volume (Mn)' = CALCULATE ( [P2x Volume (Mn)], FactP2PP2M[Payment Type] = "P2P" )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: 3e89be61-7904-5aa6-9690-acd5978938e4

	measure 'P2P Value (Cr)' = CALCULATE ( [P2x Value (Cr)], FactP2PP2M[Payment Type] = "P2P" )
		formatString: #,0
		displayFolder: 3 Merchant payments
		lineageTag: 893472dc-a03e-5812-9bb3-8736f5efee35

	/// Merchant (person-to-merchant) payments as a share of all UPI transactions.
	measure 'P2M Share of Volume %' = DIVIDE ( [P2M Volume (Mn)], [P2M Volume (Mn)] + [P2P Volume (Mn)] )
		formatString: 0.0%
		displayFolder: 3 Merchant payments
		lineageTag: f927300d-dee7-580c-a770-d17d66c1fc56

	measure 'P2M Share of Value %' = DIVIDE ( [P2M Value (Cr)], [P2M Value (Cr)] + [P2P Value (Cr)] )
		formatString: 0.0%
		displayFolder: 3 Merchant payments
		lineageTag: 390e3fc2-a32d-5c28-9ea0-1b397b020cdd

	measure 'P2M Share of Volume % (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [P2M Share of Volume %], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: 0.0%
		displayFolder: 3 Merchant payments
		lineageTag: 4be379b4-07ae-5eee-be70-8cbd0c788118

	measure 'P2M Share of Volume % (Same Month LY)' =
