/// All report measures, grouped in display folders by report page.
table _Measures
	lineageTag: fec4c795-66bc-5cd6-94f6-52f6b897a0ab

	/// Month picked in the Month slicer. With nothing picked this is the latest month in the data.
	measure 'Selected Month Index' = MAX ( DimDate[Month Index] )
		formatString: 0
		displayFolder: 0 Helpers
		lineageTag: 5ef63a6c-2e1c-5871-a573-616f1b4ef6b2

	measure 'Selected Month' = FORMAT ( MAX ( DimDate[Date] ), "mmmm yyyy" )
		displayFolder: 0 Helpers
		lineageTag: c0a625a1-320a-5483-87d5-7497d1caeb34

	measure 'Selected Month Short' = FORMAT ( MAX ( DimDate[Date] ), "mmm yyyy" )
		displayFolder: 0 Helpers
		lineageTag: 01a31418-c543-5602-b354-c5aba00a318a

	measure 'Same Month LY Label' = FORMAT ( EDATE ( MAX ( DimDate[Date] ), -12 ), "mmm yyyy" )
		displayFolder: 0 Helpers
		lineageTag: 1d8654da-cd84-5047-b7f8-b3142a63c621

	measure 'Latest Data Month' = FORMAT ( CALCULATE ( MAX ( FactUPIMonthly[Date] ), REMOVEFILTERS ( DimDate ) ), "mmmm yyyy" )
		displayFolder: 0 Helpers
		lineageTag: 778bcb8d-c6f3-5045-9835-e3628c5adb45

	measure 'Page Subtitle' = "Official NPCI statistics   |   Showing " & [Selected Month] & "   |   Data up to " & [Latest Data Month]
		displayFolder: 0 Helpers
		lineageTag: d5e8d5b0-a1fb-5130-8126-2acbbc13833c

	/// Number of UPI transactions, in millions.
	measure 'UPI Volume (Mn)' = SUM ( FactUPIMonthly[Volume Mn] )
		formatString: #,0
		displayFolder: 1 Market
		lineageTag: 8a763071-1905-58dc-9dfe-f227ed4b0d57

	/// Value of UPI transactions, in rupees crore.
	measure 'UPI Value (Cr)' = SUM ( FactUPIMonthly[Value Cr] )
		formatString: #,0
		displayFolder: 1 Market
		lineageTag: c95d2b7e-39e5-5862-9fbd-c4ab07d1428d

	measure 'UPI Volume (Bn)' = DIVIDE ( [UPI Volume (Mn)], 1000 )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: 92699c32-5481-5cce-a300-19f88b086814

	measure 'UPI Value (Lakh Cr)' = DIVIDE ( [UPI Value (Cr)], 100000 )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: a9301244-a700-510c-bb3d-b56ecfa9f2ee

	/// Hides the launch years so the fiscal-year chart stays readable.
	measure 'UPI Volume since FY19 (Bn)' = IF ( MAX ( DimDate[FY Start Year] ) >= 2018, [UPI Volume (Bn)] )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: 54031b22-76d5-5dd5-a1ea-279ca51e93be

	/// Average rupees per transaction. Crore / million x 10 = rupees.
	measure 'Avg Ticket Size (₹)' = DIVIDE ( [UPI Value (Cr)], [UPI Volume (Mn)] ) * 10
		formatString: ₹#,0
		displayFolder: 1 Market
		lineageTag: 3a23f0f7-a229-57e4-a296-327bb4e3a376

	/// Hides the launch years (2016-2019) when tiny volumes make the average meaningless.
	measure 'Avg Ticket Size since FY20 (₹)' = IF ( MAX ( DimDate[Date] ) >= DATE ( 2019, 4, 1 ), [Avg Ticket Size (₹)] )
		formatString: ₹#,0
		displayFolder: 1 Market
		lineageTag: 890d7b9f-31ab-540d-89f1-d3a2e87314c5

	measure 'Volume Bn (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [UPI Volume (Bn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: c698c943-cf73-5b76-a694-30e3541fc006

	measure 'Volume Bn (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [UPI Volume (Bn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: 73dbbb21-b043-5846-afec-5e8b380e52cf

	measure 'Volume YoY % (Month)' = DIVIDE ( [Volume Bn (Month)] - [Volume Bn (Same Month LY)], [Volume Bn (Same Month LY)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Market
		lineageTag: 75ada912-0214-5dac-86c5-9a8e2cb628e8

	measure 'Value Lakh Cr (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [UPI Value (Lakh Cr)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: 6b73690b-a0b7-5c18-ab41-dfbb2b63a6dc

	measure 'Value Lakh Cr (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [UPI Value (Lakh Cr)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0.00
		displayFolder: 1 Market
		lineageTag: 689070bd-f46f-5285-a315-8b71ac692daf

	measure 'Value YoY % (Month)' = DIVIDE ( [Value Lakh Cr (Month)] - [Value Lakh Cr (Same Month LY)], [Value Lakh Cr (Same Month LY)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Market
		lineageTag: 0284719c-f86b-5e5b-971e-7b9cb75aa404

	measure 'Avg Ticket ₹ (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [Avg Ticket Size (₹)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: ₹#,0
		displayFolder: 1 Market
		lineageTag: 2221518e-2340-5a62-8200-b24a58aec47a

	measure 'Avg Ticket ₹ (3 Years Earlier)' =
			VAR _m = [Selected Month Index] - 36
			RETURN
			    CALCULATE ( [Avg Ticket Size (₹)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: ₹#,0
		displayFolder: 1 Market
		lineageTag: ba4b50cf-6edf-5e27-b3fe-ccffba7ea0f6

	measure 'Daily Transactions Mn (Month)' =
			VAR _m = [Selected Month Index]
			VAR _d = CALCULATE ( MAX ( DimDate[Date] ), REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
			RETURN
			    DIVIDE ( [Volume Bn (Month)] * 1000, DAY ( EOMONTH ( _d, 0 ) ) )
		formatString: #,0
		displayFolder: 1 Market
		lineageTag: f0b1164c-c9b7-55ac-b5c2-6d82d8b30187

	measure 'Banks Live (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( SUM ( FactUPIMonthly[Banks Live] ), REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0
		displayFolder: 1 Market
		lineageTag: ece4e25d-1828-52d5-aec3-c46281e30452

	measure 'UPI Volume YoY %' =
			VAR _m = MAX ( DimDate[Month Index] )
			VAR _cur = [UPI Volume (Mn)]
			VAR _ly = CALCULATE ( [UPI Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m - 12 )
			RETURN
			    IF ( HASONEVALUE ( DimDate[Month Index] ) && NOT ISBLANK ( _cur ) && _ly > 0, DIVIDE ( _cur - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Market
		lineageTag: 6da98d18-a6f5-5387-8337-6aab39c4be29

	/// Months until 30 bn transactions a month if the latest year-on-year growth rate continues (compound, no seasonality).
	measure 'Months to 30 Bn' =
			VAR _v = [Volume Bn (Month)]
			VAR _g = [Volume YoY % (Month)]
			RETURN
			    IF (
			        _v >= 30, 0,
			        IF ( _g > 0 && _v > 0, ROUNDUP ( DIVIDE ( LN ( 30 / _v ), LN ( 1 + _g ) / 12 ), 0 ) )
			    )
		formatString: 0
		displayFolder: 1 Market
		lineageTag: 5b06740a-99b7-5d0a-988b-61fb89ecb9d3

	measure '30 Bn Month Projection' =
			VAR _n = [Months to 30 Bn]
			RETURN
			    IF ( ISBLANK ( _n ), "n/a", IF ( _n = 0, "Reached", FORMAT ( EDATE ( MAX ( DimDate[Date] ), _n ), "mmm yyyy" ) ) )
		displayFolder: 1 Market
		lineageTag: 7b9ff963-310e-50bf-ae01-2f9d334223e2

	measure 'App Volume (Mn)' = SUM ( FactAppMonthly[Volume Mn] )
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: 626e0595-cf94-5c0b-b9a3-eee00ff0433b

	measure 'App Value (Cr)' = SUM ( FactAppMonthly[Value Cr] )
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: 82eb9c63-7259-51fb-8f8a-7f754bcde00c

	/// Share of UPI transactions (volume) handled by the app.
	measure 'App Market Share %' = DIVIDE ( [App Volume (Mn)], CALCULATE ( [App Volume (Mn)], REMOVEFILTERS ( DimApp ) ) )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: bf779cbb-a946-5931-806e-ce32f2dd3823

	measure 'App Volume Mn (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [App Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: 38cf3623-ff20-54c0-8338-4acef5b00e57

	measure 'App Volume Mn (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [App Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: b04dcdde-9f02-5d4b-a2c4-49f6e67ce6d8

	measure 'App Share % (Month)' =
			VAR _m = [Selected Month Index]
			RETURN
			    CALCULATE ( [App Market Share %], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: 3575fbc3-14bb-56bc-8e9f-ad6b377ee411

	measure 'App Share % (Same Month LY)' =
			VAR _m = [Selected Month Index] - 12
			RETURN
			    CALCULATE ( [App Market Share %], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: a8df9fa7-f50f-57e3-848c-54c30a79525d

	/// Growth vs the same month last year. Blank for apps that were not live a year ago.
	measure 'App Volume YoY % (Month)' =
			VAR _cur = [App Volume Mn (Month)]
			VAR _ly = [App Volume Mn (Same Month LY)]
			RETURN
			    IF ( _ly > 1, DIVIDE ( _cur - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Apps
		lineageTag: cde63a98-e0b5-57cd-bfb3-876478ba37cf

	measure 'PhonePe Share % (Month)' = CALCULATE ( [App Share % (Month)], DimApp[App] = "PhonePe" )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: cb5a5c29-259a-51c0-ac51-bc220c606b87

	measure 'Google Pay Share % (Month)' = CALCULATE ( [App Share % (Month)], DimApp[App] = "Google Pay" )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: 7e6b34fb-5993-5e7e-a1ce-9f1d04a6fd8e

	measure 'Top 2 Apps Share % (Month)' = CALCULATE ( [App Share % (Month)], DimApp[App] IN { "PhonePe", "Google Pay" } )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: fe6162c0-4b0d-55c6-835e-581eec3f832d

	measure 'Top 2 Apps Share % (Same Month LY)' = CALCULATE ( [App Share % (Same Month LY)], DimApp[App] IN { "PhonePe", "Google Pay" } )
		formatString: 0.0%
		displayFolder: 2 Apps
		lineageTag: 594aa626-edd2-56d0-8d49-c3f3d7c2e243

	/// Herfindahl-Hirschman Index: sum of squared market shares. Above 2,500 = highly concentrated.
	measure 'Market Concentration HHI (Month)' =
			VAR _m = [Selected Month Index]
			VAR _total =
			    CALCULATE ( [App Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m, REMOVEFILTERS ( DimApp ) )
			RETURN
			    IF (
			        _total > 0,
			        SUMX (
			            ALL ( DimApp[App] ),
			            VAR _s = DIVIDE ( CALCULATE ( [App Volume (Mn)], REMOVEFILTERS ( DimDate ), DimDate[Month Index] = _m ), _total ) * 100
			            RETURN _s * _s
			        )
			    )
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: 1386eb38-37b7-59b3-adb8-97085684cac0

	measure 'Apps Above 30% Cap (Month)' = COUNTROWS ( FILTER ( ALL ( DimApp[App] ), [App Share % (Month)] > 0.3 ) )
		formatString: 0
		displayFolder: 2 Apps
		lineageTag: 66eef861-1833-596f-8d82-a75a26f36259

	/// Percentage points above (+) or below (-) NPCI's 30% volume cap.
	measure 'Gap to 30% Cap (pts)' = IF ( NOT ISBLANK ( [App Share % (Month)] ), ( [App Share % (Month)] - 0.3 ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Apps
		lineageTag: 80f6f660-32d0-557f-a168-043a71858d78

	/// Days until 31 Dec 2026, the 30% market-share cap deadline as last extended by NPCI (Dec 2024).
	measure 'Days to Cap Deadline' = MAX ( 0, DATEDIFF ( TODAY (), DATE ( 2026, 12, 31 ), DAY ) )
		formatString: 0
		displayFolder: 2 Apps
		lineageTag: e7b95d25-64bc-5a24-9160-5b2c6b0aa1d3

	/// Monthly transactions PhonePe would have to move to other apps to get down to 30%.
	measure 'Volume Above Cap Mn (Month)' =
			VAR _share = [PhonePe Share % (Month)]
			VAR _total = CALCULATE ( [App Volume Mn (Month)], REMOVEFILTERS ( DimApp ) )
			RETURN
			    MAX ( 0, _share - 0.3 ) * _total
		formatString: #,0
		displayFolder: 2 Apps
		lineageTag: a42a945e-4b30-5fe1-af39-c95a74ed03f6

	/// App with the highest year-on-year growth among apps that had at least 50 mn transactions a year earlier.
	measure 'Fastest Growing App (Month)' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( ALL ( DimApp[App] ), DimApp[App] <> "Others" && [App Volume Mn (Same Month LY)] >= 50 ),
			        [App Volume YoY % (Month)], DESC
			    )
			RETURN
			    IF ( COUNTROWS ( _t ) > 0, MAXX ( _t, DimApp[App] ) & " (" & FORMAT ( MAXX ( _t, [App Volume YoY % (Month)] ), "+0%" ) & ")" )
		displayFolder: 2 Apps
		lineageTag: 948c01d3-575e-5766-9b5b-64641ebb597e

	measure 'P2x Volume (Mn)' = SUM ( FactP2PP2M[Volume Mn] )
		formatString: #,0
		displayFolder: 3 Merchant payments
