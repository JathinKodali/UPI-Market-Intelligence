			VAR _ly = CALCULATE ( [State Volume Mn (Same Month LY)], KEEPFILTERS ( DimState[Classified] = "Yes" ) )
			RETURN
			    IF ( NOT ISBLANK ( _cur ) && _ly > 0, DIVIDE ( _cur - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6 States
