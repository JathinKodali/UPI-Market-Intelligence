/// NPCI monthly UPI totals since April 2016 (volume in millions, value in rupees crore).
table FactUPIMonthly
	lineageTag: 7e33d992-4c6c-5edc-be26-e1f9700e7cff

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 60ac6017-9e16-55a6-9676-9e1efe21e150
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Banks Live'
		dataType: int64
		formatString: #,0
		lineageTag: f183151d-0d74-5370-a373-d09aaf76879a
		summarizeBy: sum
		sourceColumn: Banks Live

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: f4ddcea3-d35a-5ea8-ab5b-1cdb57205f67
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Value Cr'
		dataType: double
		formatString: #,0.00
		lineageTag: d51b1855-cce3-5b1c-bddc-90e5ff322799
		summarizeBy: sum
		sourceColumn: Value Cr

		annotation SummarizationSetBy = Automatic

	partition FactUPIMonthly = m
		mode: import
		source =
				// Source: data/upi_monthly_totals.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"banks_live", Int64.Type}, {"volume_mn", type number}, {"value_cr", type number}}, "en-US"),
				    MonthNames = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date(Number.From(Text.AfterDelimiter([month], "-")), List.PositionOf(MonthNames, Text.BeforeDelimiter([month], "-")) + 1, 1), type date),
				    Renamed = Table.RenameColumns(AddDate, {{"banks_live", "Banks Live"}, {"volume_mn", "Volume Mn"}, {"value_cr", "Value Cr"}}),
				    Sorted = Table.Sort(Renamed, {{"Date", Order.Ascending}}),
				    Result = Table.SelectColumns(Sorted, {"Date", "Banks Live", "Volume Mn", "Value Cr"})
				in
				    Result

	annotation PBI_ResultType = Table

