/// Monthly UPI transactions by state (district rows summed to state level).
table FactStateMonthly
	lineageTag: 6c06b237-0c2c-5f10-bdf3-7b991e7ae536

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 96c76c4e-201b-58b0-b374-7d383a38bc4c
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column State
		dataType: string
		lineageTag: 294f3107-9b92-5c89-99c9-e489ee68d7d2
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: b4fa4476-77a9-5efa-b38b-6bf908a1e778
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Value Cr'
		dataType: double
		formatString: #,0
		lineageTag: 9b796c7f-5ddd-5f56-aaea-6249c82654e6
		summarizeBy: sum
		sourceColumn: Value Cr

		annotation SummarizationSetBy = Automatic

	partition FactStateMonthly = m
		mode: import
		source =
				// Source: data/upi_state.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", type text}, {"state", type text}, {"volume_mn", type number}, {"value_cr", type number}}, "en-US"),
				    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date([year], List.PositionOf(MonthNames, [month]) + 1, 1), type date),
				    Renamed = Table.RenameColumns(AddDate, {{"state", "State"}, {"volume_mn", "Volume Mn"}, {"value_cr", "Value Cr"}}),
				    Result = Table.SelectColumns(Renamed, {"Date", "State", "Volume Mn", "Value Cr"})
				in
				    Result

	annotation PBI_ResultType = Table

