/// Monthly UPI transactions by app (NPCI ecosystem statistics).
table FactAppMonthly
	lineageTag: ff11f33f-a5c1-5c39-aecb-f18a5d0d964b

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 69138655-78fa-5a6f-8e30-e629944470b7
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column App
		dataType: string
		lineageTag: a544047a-beb3-54fc-858e-b42e0891715f
		summarizeBy: none
		sourceColumn: App

		annotation SummarizationSetBy = Automatic

	column 'Volume Mn'
		dataType: double
		formatString: #,0.00
		lineageTag: c04f981a-7859-5e5a-a0a8-8642228a9acf
		summarizeBy: sum
		sourceColumn: Volume Mn

		annotation SummarizationSetBy = Automatic

	column 'Value Cr'
		dataType: double
		formatString: #,0
		lineageTag: 2af089ec-bd9a-56e3-a7ec-5fd7f2d7dd81
		summarizeBy: sum
		sourceColumn: Value Cr

		annotation SummarizationSetBy = Automatic

	partition FactAppMonthly = m
		mode: import
		source =
				// Source: data/upi_apps.csv (official NPCI statistics), embedded so the report refreshes on any computer
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", type text}, {"app", type text}, {"volume_mn", type number}, {"value_cr", type number}}, "en-US"),
				    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
				    AddDate = Table.AddColumn(Typed, "Date", each #date([year], List.PositionOf(MonthNames, [month]) + 1, 1), type date),
				    Renamed = Table.RenameColumns(AddDate, {{"app", "App"}, {"volume_mn", "Volume Mn"}, {"value_cr", "Value Cr"}}),
				    Result = Table.SelectColumns(Renamed, {"Date", "App", "Volume Mn", "Value Cr"})
				in
				    Result

	annotation PBI_ResultType = Table

